# codepractice environment configuration
# Copy this to .env and fill in your values

# LLM Backend: "ollama" | "lmstudio" (local) | "anthropic" | "openai" (cloud)
# Local backends keep all data on your machine. Cloud backends send prompts
# to the provider's API — API keys are read from this file / the environment
# only and are never stored in the app database.
LLM_BACKEND=ollama

# Ollama settings
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# LM Studio settings (uses OpenAI-compatible API)
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model

# Anthropic API settings (LLM_BACKEND=anthropic)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-8

# OpenAI-compatible API settings (LLM_BACKEND=openai)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# App data directory (default: ~/.codepractice)
# CODEPRACTICE_DATA_DIR=/path/to/custom/dir

# Enable debug mode (shows raw LLM prompts)
DEBUG=false
